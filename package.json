{
    "name": "havuja-bot",
    "version": "2.0.0",
    "main": "dist/index.js",
    "type": "module",
    "author": "Petrus Holm",
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.4",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "dev": "node --watch src/index.ts",
        "start": "node dist/index.js",
        "build": "tsc",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "test": "node --env-file=test/test.env --test --test-concurrency=1 'test/**/*.test.ts'",
        "test:db:up": "docker run -d --rm --name havuja-test-db -e POSTGRES_USER=havuja -e POSTGRES_PASSWORD=testpass -e POSTGRES_DB=havujatest -p 55432:5432 postgres:alpine",
        "test:db:down": "docker rm -f havuja-test-db"
    },
    "dependencies": {
        "@grammyjs/conversations": "^2.1.1",
        "cron": "^4.4.0",
        "date-fns": "^4.4.0",
        "grammy": "^1.45.1",
        "pg": "^8.22.0",
        "quickchart-js": "^4.0.0"
    }
}
